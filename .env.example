# Copy this file to .env and fill in your own Picnic account credentials.
# NEVER commit the real .env file — it is already listed in .gitignore.

# The email address you use to log in to the Picnic app.
PICNIC_EMAIL=you@example.com

# Your Picnic account password.
# Used only in-memory to authenticate; never logged, never written to disk.
PICNIC_PASSWORD=your-picnic-password

# "DE" (Germany) or "NL" (Netherlands) — these are the only two countries Picnic
# operates in. Defaults to "DE" if unset.
PICNIC_COUNTRY_CODE=DE

# Optional, opt-in only. If set, the session auth token (NOT your password) is cached
# to this file so you don't have to re-authenticate (and re-do 2FA) every time the
# server restarts. Leave unset for the default, safer behavior: the token lives in
# memory only and is discarded when the server process exits.
# PICNIC_TOKEN_CACHE_FILE=/path/to/.picnic_token_cache.json
